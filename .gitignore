__pycache__/
*.pyc
dist/
.DS_Store

# Чужие локализации, положенные сюда для построчной сверки. Это текст авторов
# соответствующих модов, а не наш, и распространять его мы не будем.
# Берётся из locale/ каждого установленного мода локально.
source-en/*
!source-en/README.md

# Ключ портала. Он должен жить в переменной окружения FACTORIO_API_KEY
# или в ~/.factorio-api-key, то есть вне репозитория. Строки ниже —
# страховка от случайного `git add`.
.factorio-api-key
*.apikey

# Сборка генерирует его из шаблона и listing.json при каждом build.
reference/PORTAL-LISTING-FULL.md
